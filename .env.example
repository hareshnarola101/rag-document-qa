# Copy to .env. docker compose reads it for the ${...} values in docker-compose.yml,
# and the app reads it when you run it outside Docker.

# "fake" runs fully offline with deterministic stand-in models (good for trying the API).
# "openai" talks to any OpenAI-compatible server: OpenAI, Ollama, vLLM, LM Studio.
LLM_PROVIDER=fake

# Local models with Ollama (docker compose --profile ollama up). Inside compose the API
# reaches Ollama at http://ollama:11434/v1, which is the default; outside Docker use
# http://localhost:11434/v1.
# LLM_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# OpenAI instead (EMBEDDING_DIM is baked into the schema: start from an empty database
# with `docker compose down -v` when you change it):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# Only used when running outside Docker; compose sets its own.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
